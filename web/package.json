{
  "name": "seattle-crime-forecast-web",
  "version": "0.1.0",
  "private": true,
  "description": "Static dashboard for the Seattle reported-crime forecasting research platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-out.mjs",
    "demo-data": "node scripts/make-demo-data.mjs",
    "prepare-assets": "node scripts/copy-maplibre-worker.mjs && node scripts/make-demo-data.mjs",
    "predev": "npm run prepare-assets",
    "prebuild": "npm run prepare-assets",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "maplibre-gl": "6.13.0",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
