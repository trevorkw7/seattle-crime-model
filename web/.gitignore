# build output & deps (also covered by the repo root .gitignore)
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
# copied from node_modules by scripts/copy-maplibre-worker.mjs
public/vendor/
# playwright artefacts (screenshots/ is kept on purpose)
test-results/
playwright-report/
# public/data/ is a committed snapshot of the Python export (python -m seacrime.export --max-live 30 --max-replay 42)
# synthetic fixtures, regenerated by `npm run prepare-assets` (prebuild/predev)
public/demo-data/
# smoke-test output (regenerated by npm run test:e2e); curated real-data captures live in screenshots/real/
screenshots/*.png
