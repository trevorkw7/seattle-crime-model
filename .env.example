# Copy to .env (never commit .env). All values optional.
# Optional Socrata app token raises API rate limits for data.seattle.gov
SOCRATA_APP_TOKEN=
# Optional: enables LLM extraction of structured news signals
ANTHROPIC_API_KEY=
# Storage locations inside the container
SEACRIME_DATA_ROOT=/var/lib/seacrime/data
SEACRIME_ARTIFACTS_ROOT=/var/lib/seacrime/artifacts
SEACRIME_EXPORT_DIR=/var/lib/seacrime/export
# Optional object-storage sync target for persistent state (gs://bucket/prefix or s3://...)
SEACRIME_STATE_URI=
